# 复制为 .env（或直接 export 后 npm start）
# LLM 为必填：不配置时模型调用会失败并记录错误，流水线无法产出

PORT=8790
HOST=127.0.0.1
DATA_FILE=./data/state.json

# OpenAI 兼容模型（DeepSeek / OpenAI / 通义 / 本地 vLLM 均可）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# 执行机池与节奏
EXEC_POOL_CAP=8
PACE_STAGE_STEP_MS=260
PACE_CASE_EXEC_MS=170

# 常驻回归线
AUTO_START=0   # 置 1 则启动即自动跑演示种子流水线
AUTO_LOOP_SEC=18

# 上下文压缩阈值（token 占预算比例）
CTX_COMPACT_RATIO=0.55
